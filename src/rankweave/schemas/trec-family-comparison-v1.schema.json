{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contextualwisdomlab:rankweave:trec-family-comparison:v1",
  "title": "RankWeave TREC candidate-family comparison report v1",
  "description": "The default candidate-family RankWeave CLI transport without input-artifact digest evidence.",
  "$comment": "candidate_count equals the length of candidates; every candidate shares the top-level metric, alternative, query order, and familywise_alpha. These cross-field invariants are guaranteed by RankWeave generation but are not expressible in portable Draft 2020-12 JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rankweave_version",
    "baseline_run_id",
    "cutoff",
    "metric_name",
    "alternative",
    "familywise_alpha",
    "candidate_count",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "rankweave.trec-family-comparison.v1"
    },
    "rankweave_version": {
      "type": "string",
      "minLength": 1
    },
    "baseline_run_id": {
      "$ref": "#/$defs/run_id"
    },
    "cutoff": {
      "type": "integer",
      "minimum": 1
    },
    "metric_name": {
      "$ref": "#/$defs/metric_name"
    },
    "alternative": {
      "$ref": "#/$defs/alternative"
    },
    "familywise_alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate_comparison"
      }
    }
  },
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,20}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^=\\u0000-\\u001F\\u007F]+$"
    },
    "metric_name": {
      "enum": [
        "precision_at_k",
        "recall_at_k",
        "reciprocal_rank_at_k",
        "ndcg_at_k"
      ]
    },
    "alternative": {
      "enum": [
        "two-sided",
        "candidate-greater",
        "candidate-less"
      ]
    },
    "method": {
      "enum": [
        "exact",
        "monte-carlo"
      ]
    },
    "unit_interval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signed_unit_interval": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "query_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "baseline_value",
        "candidate_value",
        "difference"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_value": {
          "$ref": "#/$defs/unit_interval"
        },
        "candidate_value": {
          "$ref": "#/$defs/unit_interval"
        },
        "difference": {
          "$ref": "#/$defs/signed_unit_interval"
        }
      }
    },
    "candidate_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_run_id",
        "query_count",
        "nonzero_difference_count",
        "baseline_mean",
        "candidate_mean",
        "mean_difference",
        "raw_p_value",
        "holm_adjusted_p_value",
        "rejected_at_familywise_alpha",
        "method",
        "randomizations_evaluated",
        "random_seed",
        "query_differences"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "candidate_run_id": {
          "$ref": "#/$defs/run_id"
        },
        "query_count": {
          "type": "integer",
          "minimum": 1
        },
        "nonzero_difference_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_mean": {
          "$ref": "#/$defs/unit_interval"
        },
        "candidate_mean": {
          "$ref": "#/$defs/unit_interval"
        },
        "mean_difference": {
          "$ref": "#/$defs/signed_unit_interval"
        },
        "raw_p_value": {
          "$ref": "#/$defs/unit_interval"
        },
        "holm_adjusted_p_value": {
          "$ref": "#/$defs/unit_interval"
        },
        "rejected_at_familywise_alpha": {
          "type": "boolean"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "randomizations_evaluated": {
          "type": "integer",
          "minimum": 1
        },
        "random_seed": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_differences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/query_difference"
          }
        }
      }
    }
  }
}
